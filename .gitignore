.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
dist/
build/

# Virtual environment
.venv/

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Environment and local credentials. These hold secrets or machine-specific
# settings and are ignored here, not only by a contributor's own excludes, so a
# fresh clone cannot commit them.
.env
.env.*
!.env.example
*.pem
*.key
.mcp.json
CLAUDE.local.md
**/.claude/settings.local.json

# Workflow activation receipt: local evidence for one checkout, never shared
/.development-skills/activation-receipt.md

# Claude Code scratch (worktrees created by EnterWorktree)
.claude/worktrees/

# Claude Code runtime locks (e.g. scheduled_tasks.lock — singleton scheduler lock)
.claude/*.lock

# Generated data files
repo_file_inventory.xlsx

# Session-continuity / planning context artifacts at repo root — transient
# handoff notes, deleted once their planning work completes; not tracked.
/context-*.md

# Generated complete workflow installation (canonical review pointer stays tracked)
/.agents/skills/*
!/.agents/skills/cas-code-review/
/.agents/.workflow-install/
