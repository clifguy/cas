# syntax=docker/dockerfile:1
#
# CAS backend-for-frontend (BFF) container image.
#
# Packages the standalone BFF process (`python -m app.backend`) for the cloud
# profile: it serves the built SPA same-origin and reaches SAGE over HTTP. A
# Node stage builds the SPA bundle; a Python runtime stage serves that bundle
# alongside the BFF API. Non-root, minimized, health-checked. Unlike the SAGE
# image it bakes no embedder weights -- the BFF constructs no embedder. The
# build is repo-less, so the runtime version comes from the SAGE_BUILD_VERSION
# build arg (see build_info).
#
# Build:  docker build -f Dockerfile.bff --build-arg SAGE_BUILD_VERSION=<MAJOR.MINOR.PATCH> -t cas-bff .
# Run:    docker run -p 8001:8001 cas-bff          # boots on the baked smoke config
# See docs/process/bff-container-image.md.

# Base images are digest-pinned so two builds of one commit resolve the same
# bases. The deploy path leans on that: the image the deploy pushes is not
# smoke-tested itself, but is accepted on the strength of the CI run for that
# commit having built from the same bases and the same locked dependency sets.
#
# This image reaches further than the SAGE one does. It installs no apt packages
# and bakes no model weights, so the pins plus `package-lock.json` and `uv.lock`
# cover every input the build resolves -- two builds of one commit really are
# byte-identical here, cache or no cache. A moving tag would give that up
# silently. Keep the readable tag ahead of the digest when bumping.
#
# Every pin below sits on a FROM line, and has to stay on one. Dependabot's
# docker ecosystem is what keeps these pins from ageing into missed upstream
# security fixes, and it reads FROM lines and nothing else: it does not resolve
# an `ARG *_IMAGE` default, substitute a build arg, or look at `COPY --from=`. A
# pin moved to any of those keeps its digest and keeps passing the pinning gate
# while silently receiving no further updates. The `python-base` alias below is how
# the two Python stages share one definition point without hiding it from the
# updater; the Node base has a single consumer and so names its stage directly.
# `tests/deploy/test_dependabot_base_image_coverage.py` enforces this, and the
# readable `node:<major>` tag is additionally read by the frontend Node-version
# gate, so neither the tag nor the digest may be dropped.
FROM python:3.14-slim@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6 AS python-base

# uv drives the install from the committed lockfile (byte-identical to CI). It is
# a stage rather than a bare `COPY --from=<image>` for the visibility reason above.
FROM ghcr.io/astral-sh/uv:0.12.10@sha256:2bb3ebca0a796a155094a27773d290c4b074572e6107f171d88d086682fd2500 AS uv

# --------------------------------------------------------------------------
# SPA builder: produce the static frontend bundle with Vite.
# --------------------------------------------------------------------------
FROM node:26-slim@sha256:c0753125a3789977aefe869cbebccf70e3cfd7ea84ca48547458f02e4f1d7146 AS spa-builder

WORKDIR /app

# Dependency layer (cached unless the lock changes).
COPY app/package.json app/package-lock.json ./
RUN npm ci

# Frontend source, then the production build (`tsc -b && vite build`) -> /app/dist.
COPY app/ ./
RUN npm run build

# --------------------------------------------------------------------------
# Python builder: resolve the locked runtime dependencies.
# --------------------------------------------------------------------------
FROM python-base AS py-builder

COPY --from=uv /uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /opt/bff

# Dependency layer (cached unless the lock changes): base runtime deps only --
# no test/mlx/dev/ocr extras. On Linux, torch resolves to the CPU wheel index
# pinned in pyproject's [tool.uv.sources]. No embedder weights are pre-baked:
# the BFF owns no vault registry and never constructs an embedder.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

# Project source. The BFF imports the sage package (config, errors, the auth
# substrate, the profile registry) and the application backend; the SPA bundle
# is produced by the Node stage above, not resolved from Python source here.
COPY sage/ ./sage/
COPY app/backend/ ./app/backend/
RUN uv sync --locked --no-dev

# --------------------------------------------------------------------------
# Runtime: non-root, minimized, serves the SPA and the BFF API, health check.
# --------------------------------------------------------------------------
FROM python-base AS runtime

RUN groupadd --system bff \
    && useradd --system --gid bff --create-home --home-dir /home/bff bff

# Baked at build time so a .git-less image reports its real version
# (build_info resolves SAGE_BUILD_VERSION when no live git checkout is present).
ARG SAGE_BUILD_VERSION
ENV SAGE_BUILD_VERSION=${SAGE_BUILD_VERSION} \
    PATH=/opt/bff/.venv/bin:$PATH \
    SAGE_CONFIG_PATH=/opt/bff/deploy/sage.config.container.yaml

WORKDIR /opt/bff
COPY --from=py-builder /opt/bff/.venv /opt/bff/.venv
COPY --from=py-builder /opt/bff/sage /opt/bff/sage
COPY --from=py-builder /opt/bff/app /opt/bff/app
# The built SPA bundle, served same-origin from <app>/dist (app.backend.asgi).
COPY --from=spa-builder /app/dist /opt/bff/app/dist
COPY deploy/sage.config.container.yaml /opt/bff/deploy/sage.config.container.yaml
# The stack-config JSON Schema that sage/config.py validates the loaded config
# against at startup -- the sole docs/fs file the runtime reads, expected at
# <repo-root>/docs/fs/sage/ (parents[1] of sage/config.py, i.e. /opt/bff here).
COPY docs/fs/sage/sage_core_config.schema.json /opt/bff/docs/fs/sage/sage_core_config.schema.json

RUN chown -R bff:bff /opt/bff/app/dist
USER bff
EXPOSE 8001

# Liveness probe on the loopback interface inside the container. External
# reachability requires the non-loopback bind in CMD below. No vaults load, so
# the start period is short.
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=2).status == 200 else 1)"]

# Bind a non-loopback interface so the platform ingress can reach the process.
ENTRYPOINT ["python", "-m", "app.backend"]
CMD ["--host", "0.0.0.0", "--port", "8001"]
