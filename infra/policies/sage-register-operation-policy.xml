<policies>
    <inbound>
        <!--
            Operation-scoped policy for POST /register (CAS-ADR-042).
            Answers every Dynamic Client Registration attempt (RFC 7591) with the
            single pre-provisioned public client id—Entra offers no real DCR,
            so this static response lets a standards-default MCP client complete
            its discovery-then-register leg without any registration actually
            occurring. token_endpoint_auth_method is "none": the client is a
            PKCE public client (authorization-code + PKCE, no secret) and never
            receives one.

            The response MUST carry redirect_uris. An RFC 7591 client parses this
            response against its full client-information schema, in which
            redirect_uris is a required, non-empty array of valid URLs (the MCP
            reference client's OAuthClientInformationFullSchema — a strict parse
            that throws if the field is absent). Omitting it makes a standards
            client report "couldn't register" before it ever reaches /authorize,
            even though the 201 and client_id are correct. The client uses its
            OWN redirect_uri at /authorize, not this echoed set, so the value here
            only has to satisfy that parse; we return the two callbacks actually
            registered on the mcp client in Entra — the hosted-surface HTTPS
            callback and the loopback the CLI/native surface uses. Keep this set
            in step with the redirect URIs registered in
            deploy/bootstrap/entra-app-registrations.sh; both are protocol
            constants of the MCP client, not per-tenant coordinates.

            The scope is prefixed with {{sage-resource-url}} (the sage custom
            domain, registered as an identifier URI on the Entra resource app),
            not the api://<app-id> audience URI — Entra pre-auth requires the
            client's RFC 8707 resource parameter to be consistent with the
            requested scope's resource (AADSTS9010010 otherwise). Full rationale
            in the discovery policy.

            There is deliberately no <base /> here, matching the discovery and
            authorization-server operations: the registration call is
            unauthenticated by design (the client has no token yet at this step).
        -->
        <!--
            CORS (CAS-ADR-042): this anonymous operation omits <base />, so it
            never runs the API-level <cors>. It carries its own so the actual
            response a browser reads cross-origin returns Access-Control-Allow-*.
        -->
        <cors allow-credentials="false">
            <allowed-origins>
                <origin>*</origin>
            </allowed-origins>
            <allowed-methods>
                <method>GET</method>
                <method>POST</method>
                <method>OPTIONS</method>
            </allowed-methods>
            <allowed-headers>
                <header>Authorization</header>
                <header>Content-Type</header>
            </allowed-headers>
        </cors>
        <return-response>
            <set-status code="201" reason="Created" />
            <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
            </set-header>
            <set-body>{
  "client_id": "{{mcp-client-id}}",
  "redirect_uris": ["https://claude.ai/api/mcp/auth_callback", "http://localhost/callback"],
  "token_endpoint_auth_method": "none",
  "grant_types": ["authorization_code"],
  "response_types": ["code"],
  "scope": "{{sage-resource-url}}/Sage.Access offline_access"
}</set-body>
        </return-response>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
