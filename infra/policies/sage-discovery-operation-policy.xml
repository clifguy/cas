<policies>
    <inbound>
        <!--
            Operation-scoped policy for GET /.well-known/oauth-protected-resource
            (CAS-ADR-042). Serves the MCP OAuth protected-resource-metadata
            document directly at the edge for the unauthenticated discovery
            handshake (RFC 9728 / the MCP authorization profile).

            authorization_servers points at this facade's own authorization-server
            metadata (CAS-ADR-042), not directly at the raw Entra issuer:
            a default MCP client fetches that URL's own
            /.well-known/oauth-authorization-server, and only the facade's copy
            advertises a registration_endpoint (Entra's real AS metadata has none).

            resource and the scope prefix are BOTH {{sage-resource-url}} (the
            sage custom domain), and that same identity must be registered as an
            identifier URI on the Entra resource app (the bootstrap declares it).
            Two independent checks require this coherence: (1) the client rejects
            a resource that does not match the server origin it connected to
            (RFC 9728 confused-deputy protection — the reference client throws
            "Protected resource ... does not match expected" on a mismatch);
            (2) the client sends an RFC 8707 resource parameter to /authorize
            composed from this document, and Entra pre-auth requires that
            parameter to be consistent with the requested scope's resource — an
            api://<app-id>-prefixed scope against an https resource fails
            AADSTS9010010 (invalid_target) before the login page ever renders.
            Verified live on cor-prod.

            There is deliberately no <base /> here: omitting it skips the
            API-level inbound policy (validate-jwt), so the document is reachable
            without a token. And because routing is by operation (a literal
            urlTemplate), no policy expression evaluates an inline path-string
            literal — the encoding the loadTextContent -> ARM -> APIM round-trip
            corrupts. Environment coordinates arrive as APIM named values ({{...}}).
        -->
        <!--
            CORS (CAS-ADR-042): this anonymous operation omits <base />, so it
            never runs the API-level <cors>. It carries its own so the actual
            response a browser reads cross-origin returns Access-Control-Allow-*.
        -->
        <cors allow-credentials="false">
            <allowed-origins>
                <origin>*</origin>
            </allowed-origins>
            <allowed-methods>
                <method>GET</method>
                <method>POST</method>
                <method>OPTIONS</method>
            </allowed-methods>
            <allowed-headers>
                <header>Authorization</header>
                <header>Content-Type</header>
            </allowed-headers>
        </cors>
        <return-response>
            <set-status code="200" reason="OK" />
            <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
            </set-header>
            <set-body>{
  "resource": "{{sage-resource-url}}",
  "authorization_servers": ["{{sage-resource-url}}"],
  "scopes_supported": ["{{sage-resource-url}}/Sage.Access", "offline_access"],
  "bearer_methods_supported": ["header"]
}</set-body>
        </return-response>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
