<policies>
    <inbound>
        <base />
        <!--
            SAGE public-edge default policy for the CAS cloud deployment profile
            (CAS-ADR-042). This is the catch-all pipeline for every surface that
            is not a dedicated operation: validate the Entra JWT (single issuer,
            single audience, uniform across every surface — the REST API, the
            ordinary MCP mount, and the maintenance mount alike), then route to
            the SAGE backend. Authentication and authorization are the sole admin
            control; no surface is denied at the edge.

            The unauthenticated surfaces — the OAuth discovery doc and /health —
            are served by their own dedicated GET operations whose operation-scoped
            policies omit <base />, so they never reach this validate-jwt. Routing
            by operation (a literal urlTemplate) keeps this policy free of any
            inline path-string literal: there is no <when> condition here for the
            loadTextContent -> ARM -> APIM round-trip to double-encode.

            Environment coordinates arrive as APIM named values ({{...}}): the
            tenant id and the SAGE audience.
        -->
        <validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized">
            <openid-config url="https://login.microsoftonline.com/{{entra-tenant-id}}/v2.0/.well-known/openid-configuration" />
            <audiences>
                <audience>{{sage-audience}}</audience>
            </audiences>
        </validate-jwt>
        <set-backend-service backend-id="sage-backend" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
        <!--
            On an authentication failure, advertise where the protected-resource
            metadata lives so an MCP client can begin the OAuth handshake
            (RFC 9728 / the MCP authorization profile).
        -->
        <choose>
            <when condition="@(context.Response?.StatusCode == 401)">
                <set-header name="WWW-Authenticate" exists-action="override">
                    <value>Bearer resource_metadata="{{sage-resource-url}}/.well-known/oauth-protected-resource"</value>
                </set-header>
            </when>
        </choose>
    </on-error>
</policies>
