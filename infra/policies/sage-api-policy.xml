<policies>
    <inbound>
        <base />
        <!--
            CORS preflight (CAS-ADR-042). A browser-context MCP/OAuth client
            (Claude Desktop, the claude.ai connector) sends a preflight OPTIONS
            before the real request. This <cors> sits AHEAD of validate-jwt so the
            preflight is answered anonymously and short-circuited before the JWT
            gate; otherwise validate-jwt 401s the tokenless preflight and the
            browser blocks the call. Every preflight routes here through the
            catch-all operation, so one API-level <cors> covers all paths.
            allow-credentials is false because MCP clients authenticate with a
            bearer token in the Authorization header, not cookies, so a wildcard
            origin is valid. The Mcp-* entries carry the Streamable HTTP
            transport's protocol headers: a client sends Mcp-Session-Id and
            MCP-Protocol-Version on every post-initialize request, and must be
            able to read Mcp-Session-Id off the initialize response
            (expose-headers) when the server mints one.
        -->
        <cors allow-credentials="false">
            <allowed-origins>
                <origin>*</origin>
            </allowed-origins>
            <allowed-methods>
                <method>GET</method>
                <method>POST</method>
                <method>OPTIONS</method>
            </allowed-methods>
            <allowed-headers>
                <header>Authorization</header>
                <header>Content-Type</header>
                <header>Mcp-Session-Id</header>
                <header>MCP-Protocol-Version</header>
            </allowed-headers>
            <expose-headers>
                <header>Mcp-Session-Id</header>
            </expose-headers>
        </cors>
        <!--
            SAGE public-edge default policy for the CAS cloud deployment profile
            (CAS-ADR-042). This is the catch-all pipeline for every surface that
            is not a dedicated operation: validate the Entra JWT (single issuer,
            uniform across every surface — the REST API, the ordinary MCP mount,
            and the maintenance mount alike), then route to the SAGE backend.
            Authentication and authorization are the sole admin control; no
            supported surface is denied at the edge; retired protocol paths return 404.

            The audience is accepted in both canonical forms for the SAGE
            resource: its App ID URI ({{sage-audience}}, api://<app-id>) and its
            bare application-id GUID ({{sage-audience-guid}}). A v2.0 access
            token carries the bare GUID as its aud, so the JWT policy must admit
            it alongside the URI; a token for any other resource is still rejected.

            The unauthenticated surfaces — the OAuth discovery doc, /health, and
            the OpenAPI schema document — are served by their own dedicated GET
            operations whose operation-scoped policies omit <base />, so they never
            reach this validate-jwt. Routing
            by operation (a literal urlTemplate) avoids discovery path-string routing.
            The retirement condition below uses the same round-trip-safe
            double-quoted attribute encoding as the on-error challenges.

            Environment coordinates arrive as APIM named values ({{...}}): the
            tenant id and the SAGE audience.
        -->
        <!-- Retired protocol paths are not OAuth resources. Match whole
             segments, so unrelated routes still follow the normal pipeline. -->
        <choose>
            <when condition="@(context.Request.OriginalUrl.Path == &quot;/mcp_admin&quot; || context.Request.OriginalUrl.Path.StartsWith(&quot;/mcp_admin/&quot;) || context.Request.OriginalUrl.Path == &quot;/.well-known/oauth-protected-resource/mcp_admin&quot; || context.Request.OriginalUrl.Path.StartsWith(&quot;/.well-known/oauth-protected-resource/mcp_admin/&quot;))">
                <return-response>
                    <set-status code="404" reason="Not Found" />
                </return-response>
            </when>
        </choose>
        <validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized">
            <openid-config url="https://login.microsoftonline.com/{{entra-tenant-id}}/v2.0/.well-known/openid-configuration" />
            <audiences>
                <audience>{{sage-audience}}</audience>
                <audience>{{sage-audience-guid}}</audience>
            </audiences>
        </validate-jwt>
        <set-backend-service backend-id="sage-backend" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
        <!--
            On an authentication failure, split by client. A human browser gets a
            redirect to the CAS app so a tokenless visit reads as a sign-in surface,
            not a raw 401; every machine client keeps the byte-identical
            protected-resource challenge so an MCP client can begin the OAuth
            handshake (RFC 9728 / the MCP authorization profile).

            The browser is detected by an Accept: text/html test. That needs a
            quoted string literal inside a <when condition="@(...)"> attribute — the
            one construct the loadTextContent -> ARM -> APIM round-trip can corrupt.
            The round-trip-safe encoding is a double-quoted attribute with the inner
            string delimiters escaped as &quot; (never a single-quoted attribute with
            literal inner double quotes, which the pipeline normalizes and breaks).
            The redirect target arrives as the {{cas-app-url}} named value, so this
            policy carries no hardcoded domain.
        -->
        <choose>
            <when condition="@(context.Response?.StatusCode == 401)">
                <choose>
                    <when condition="@(context.Request.Headers.GetValueOrDefault(&quot;Accept&quot;, &quot;&quot;).Contains(&quot;text/html&quot;))">
                        <return-response>
                            <set-status code="302" reason="Found" />
                            <set-header name="Location" exists-action="override">
                                <value>{{cas-app-url}}</value>
                            </set-header>
                        </return-response>
                    </when>
                    <otherwise>
                        <!--
                            The challenge is PATH-AWARE: a client denied on an MCP
                            mount is pointed at that mount's RFC 9728 path-inserted
                            metadata document, whose `resource` is the path-carrying
                            mount URI. The root document's bare-host resource
                            serializes with a trailing slash under client URL
                            normalization (https://host -> https://host/), a form
                            Entra can neither match nor register as an identifier
                            URI, so a client steered to the root document dead-ends
                            at /authorize with AADSTS9010010 (invalid_target).
                            Exact or path-segment matching prevents retired or
                            lookalike mounts from advertising a supported mount's
                            discovery document. The path-string
                            literals use the round-trip-safe &quot;-escaped
                            double-quoted attribute encoding (see the Accept test
                            above).
                        -->
                        <choose>
                            <when condition="@(context.Request.OriginalUrl.Path == &quot;/mcp_maint&quot; || context.Request.OriginalUrl.Path.StartsWith(&quot;/mcp_maint/&quot;))">
                                <set-header name="WWW-Authenticate" exists-action="override">
                                    <value>Bearer resource_metadata="{{sage-resource-url}}/.well-known/oauth-protected-resource/mcp_maint"</value>
                                </set-header>
                            </when>
                            <when condition="@(context.Request.OriginalUrl.Path == &quot;/mcp&quot; || context.Request.OriginalUrl.Path.StartsWith(&quot;/mcp/&quot;))">
                                <set-header name="WWW-Authenticate" exists-action="override">
                                    <value>Bearer resource_metadata="{{sage-resource-url}}/.well-known/oauth-protected-resource/mcp"</value>
                                </set-header>
                            </when>
                            <otherwise>
                                <set-header name="WWW-Authenticate" exists-action="override">
                                    <value>Bearer resource_metadata="{{sage-resource-url}}/.well-known/oauth-protected-resource"</value>
                                </set-header>
                            </otherwise>
                        </choose>
                    </otherwise>
                </choose>
            </when>
        </choose>
    </on-error>
</policies>
